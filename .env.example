# Copy this file to .env and adjust for your machine.
# Never commit real secrets — .env is gitignored.

# Port the Express API / production server listens on
PORT=4000

# Secret used to sign session JWTs (use a long random string in real deployments)
JWT_SECRET=change-me-to-a-long-random-string

# Session lifetime
JWT_EXPIRES_IN=8h

# PostgreSQL connection string used by Prisma (CLI reads .env automatically)
# Example: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/vendorbridge?sslmode=require

# Set to "production" when serving the built frontend from Express
NODE_ENV=development

# Comma-separated origins allowed to call the API with credentials.
# Password-reset links use the first origin in production; set it to your public app URL.
CLIENT_ORIGIN=http://localhost:5173

# Optional Redis. Used for shared, persistent rate-limit counters and for the
# read cache in front of /api/dashboard (20 s) and /api/vendors/meta (60 s).
# When unset — or when Redis is unreachable — counters fall back to PostgreSQL
# (see the rate_limits table) and reads go straight to the database, so a Redis
# outage never breaks sign-in.
#
# Two forms are accepted, and either one works in production:
#   Upstash REST (recommended on Vercel): copy the REST URL and token from the
#   Upstash console. The Vercel Upstash integration injects these for you.
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
#   Redis protocol, including Upstash's TLS endpoint (local Redis also works):
# REDIS_URL=rediss://default:PASSWORD@your-instance.upstash.io:6379
#
# Pasting the https:// REST URL into REDIS_URL is understood as long as the
# token is set; a local redis://localhost:6379 is only reachable on a machine
# that actually runs Redis, never from a deployed serverless function.

# Transactional email (Resend) used to deliver password-reset links and Week 3
# invoice emails. With RESEND_API_KEY set, both are sent through the Resend HTTP
# API (invoice emails carry the PDF attachment).
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM="VendorBridge <onboarding@resend.dev>"

# Week 3 invoice delivery is strict about configuration: with no provider set,
# POST /api/invoices/:id/send answers 503 email_not_configured and records that
# state instead of pretending the invoice was sent. Set this to true for local
# development to opt into the file-based dev outbox (.mail-outbox.jsonl).
# It never applies when NODE_ENV=production.
# EMAIL_DEV_OUTBOX=true

# Local-development only: expose /api/auth/dev-reset-link so the browser can
# open a reset link without an email provider. That endpoint hands a live reset
# token to any caller, so it stays disabled unless explicitly set to true and
# never works when NODE_ENV=production. Leave it unset to use the mail outbox.
# ALLOW_DEV_RESET_LINK=true
