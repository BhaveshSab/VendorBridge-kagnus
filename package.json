{
  "name": "vendorbridge",
  "private": true,
  "version": "1.0.0",
  "description": "VendorBridge — Procurement & Vendor Management ERP (Kagnus Week 1)",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "node scripts/db-status.js",
    "db:setup": "npm run db:generate && npm run db:deploy && npm run seed && npm run db:status",
    "db:studio": "prisma studio",
    "test:api": "node scripts/smoke-test.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "typecheck": "tsc -b --pretty false",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "rate-limit-redis": "^6.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.104.4",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.545.0",
    "prisma": "^6.19.3",
    "puppeteer-core": "^25.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
