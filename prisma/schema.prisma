generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int             @id @default(autoincrement())
  firstName      String          @map("first_name")
  lastName       String          @map("last_name")
  email          String          @unique
  phone          String?
  country        String?
  role           String
  additionalInfo String?         @map("additional_info")
  passwordHash   String          @map("password_hash")
  createdAt      DateTime        @map("created_at")
  vendors        Vendor[]        @relation("VendorAccount")
  createdVendors Vendor[]        @relation("VendorCreator")
  passwordResets PasswordReset[]

  @@map("users")
}

model PasswordReset {
  token     String   @id
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  used      Int      @default(0) @map("used")
  createdAt DateTime @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model Vendor {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  category    String
  gstin       String?
  email       String
  phone       String?
  address     String?
  city        String?
  country     String?
  contactName String?  @map("contact_name")
  status      String   @default("Pending")
  rating      Float    @default(0)
  notes       String?
  userId      Int?     @map("user_id")
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")
  account     User?    @relation("VendorAccount", fields: [userId], references: [id], onDelete: SetNull)
  creator     User?    @relation("VendorCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@map("vendors")
}

model Counter {
  name  String @id
  value Int

  @@map("counters")
}
